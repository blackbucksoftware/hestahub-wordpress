{
    "name": "blackbucksoftware/hestahub-wordpress",
    "description": "Shows a HestaHub Tenant's Apartments, availability and Clinics on the Tenant's own WordPress site.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.1",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "squizlabs/php_codesniffer": "^3.13 || ^4.0",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "HestaHub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HestaHub\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "optimize-autoloader": true,
        "platform-check": false,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude build --exclude .wp-tests .",
        "compat": [
            "phpcs",
            "phpcs --standard=PHPCompatibility --runtime-set testVersion 7.4 --extensions=php lib"
        ],
        "test": "phpunit"
    }
}
