<?xml version="1.0"?>
<ruleset name="HestaHub">
	<description>PHP compatibility with the plugin's PHP floor.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/.wp-tests/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<!-- Vendored, unmodified (bin/vendor-update-checker.sh). `composer compat` checks it against PHP 7.4 alone: it may use behaviour newer PHP deprecates, but must run on the floor. -->
	<exclude-pattern>/lib/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibility"/>
</ruleset>
