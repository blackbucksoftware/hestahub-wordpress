{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.hestahub.com/v1/2026-11-23/apartments.schema.json",
  "title": "GET /api/v1/apartments — success",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "data",
    "revision",
    "cache",
    "currency",
    "prices_include_tax"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "slug",
          "name",
          "description",
          "building",
          "qm",
          "max_persons",
          "features",
          "images",
          "blueprint",
          "pricing",
          "portal_url"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "building": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "key",
                  "name",
                  "position"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "position": {
                    "type": "integer"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "qm": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "max_persons": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "url",
                "caption",
                "is_primary"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "caption": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "is_primary": {
                  "type": "boolean"
                }
              }
            }
          },
          "blueprint": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              {
                "type": "null"
              }
            ]
          },
          "pricing": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "seasons"
            ],
            "properties": {
              "seasons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "key",
                    "name",
                    "is_default",
                    "periods",
                    "tiers",
                    "bundles"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "is_default": {
                      "type": "boolean"
                    },
                    "periods": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "required": [
                          "first_day",
                          "last_day"
                        ],
                        "properties": {
                          "first_day": {
                            "type": "string",
                            "format": "date",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          },
                          "last_day": {
                            "type": "string",
                            "format": "date",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          }
                        },
                        "description": "Inclusive range."
                      }
                    },
                    "tiers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "required": [
                          "name",
                          "min_nights",
                          "max_nights",
                          "price_per_night",
                          "final_cleaning_fee"
                        ],
                        "properties": {
                          "name": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "min_nights": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "max_nights": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "price_per_night": {
                            "type": "string",
                            "pattern": "^\\d+\\.\\d{2}$",
                            "description": "Decimal string, two places. Never do arithmetic on it."
                          },
                          "final_cleaning_fee": {
                            "type": "string",
                            "pattern": "^\\d+\\.\\d{2}$",
                            "description": "Decimal string, two places. Never do arithmetic on it."
                          }
                        }
                      }
                    },
                    "bundles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "required": [
                          "name",
                          "nights",
                          "total_price",
                          "description",
                          "final_cleaning_fee"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "nights": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "total_price": {
                            "type": "string",
                            "pattern": "^\\d+\\.\\d{2}$",
                            "description": "Decimal string, two places. Never do arithmetic on it."
                          },
                          "description": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "final_cleaning_fee": {
                            "type": "string",
                            "pattern": "^\\d+\\.\\d{2}$",
                            "description": "Decimal string, two places. Never do arithmetic on it."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "portal_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "cache": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ttl",
        "stale_ttl"
      ],
      "properties": {
        "ttl": {
          "type": "integer",
          "minimum": 0
        },
        "stale_ttl": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "prices_include_tax": {
      "type": "boolean"
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
