{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.hestahub.com/v1/2026-11-23/availability.schema.json",
  "title": "GET /api/v1/availability — success",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "data",
    "revision",
    "cache"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "from",
        "to",
        "apartments"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "apartments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "slug",
              "blocked"
            ],
            "properties": {
              "slug": {
                "type": "string",
                "minLength": 1
              },
              "blocked": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "to": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  },
                  "description": "Half-open: from is the first blocked night, to is the morning the stay ends."
                }
              }
            }
          }
        }
      }
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "cache": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ttl",
        "stale_ttl"
      ],
      "properties": {
        "ttl": {
          "type": "integer",
          "minimum": 0
        },
        "stale_ttl": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
