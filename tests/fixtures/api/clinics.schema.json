{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.hestahub.com/v1/2026-11-23/clinics.schema.json",
  "title": "GET /api/v1/clinics — success",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "data",
    "revision",
    "cache",
    "currency",
    "prices_include_tax"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "slug",
          "name",
          "description",
          "photo_url",
          "thumbnail_url",
          "starts_at",
          "ends_at",
          "min_participants",
          "horses",
          "apartment_guests_only",
          "fee",
          "loan_horse_fee",
          "signup",
          "signup_opens_at",
          "signup_closes_at",
          "portal_url"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "photo_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              {
                "type": "null"
              }
            ]
          },
          "thumbnail_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              {
                "type": "null"
              }
            ]
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "min_participants": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "horses": {
            "type": "string",
            "description": "Enum-like: own_only | own_or_loan | none."
          },
          "apartment_guests_only": {
            "type": "boolean"
          },
          "fee": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+\\.\\d{2}$",
                "description": "Decimal string, two places. Never do arithmetic on it."
              },
              {
                "type": "null"
              }
            ]
          },
          "loan_horse_fee": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+\\.\\d{2}$",
                "description": "Decimal string, two places. Never do arithmetic on it."
              },
              {
                "type": "null"
              }
            ]
          },
          "signup": {
            "type": "string",
            "description": "Enum-like: not_yet_open | open | waitlist | full | closed."
          },
          "signup_opens_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "signup_closes_at": {
            "type": "string",
            "format": "date-time"
          },
          "portal_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "cache": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ttl",
        "stale_ttl"
      ],
      "properties": {
        "ttl": {
          "type": "integer",
          "minimum": 0
        },
        "stale_ttl": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "prices_include_tax": {
      "type": "boolean"
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
