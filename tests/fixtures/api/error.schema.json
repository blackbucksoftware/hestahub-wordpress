{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.hestahub.com/v1/2026-11-23/error.schema.json",
  "title": "Error envelope, every endpoint",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "error",
    "revision",
    "docs_url"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "Contractual, enum-like: unauthorized | key_revoked | tenant_inactive | module_disabled | not_found | version_gone | server_error."
        },
        "message": {
          "type": "string",
          "description": "Not contractual. Never shown to a visitor."
        }
      }
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "docs_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
